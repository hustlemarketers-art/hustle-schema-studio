{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://example.com/#localbusiness",
      "name": "Example Studio Downtown",
      "url": "https://example.com/",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "123 Example Street",
        "addressLocality": "Example City",
        "addressRegion": "CA",
        "postalCode": "90001",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 0,
        "longitude": 0
      }
    }
  ]
}
